  "positive_framing_rules": {
    "principle": "NEVER frame the relationship negatively. Always frame as opportunity, growth, mastery.",

    "wrong_examples": [
      { "wrong": "Was fehlt euch am meisten?", "right": "Was wünscht ihr euch voneinander?" },
      { "wrong": "Worüber streitet ihr euch?", "right": "Wie löst ihr Spannungen gemeinsam?" },
      { "wrong": "Was ist euer größtes Problem?", "right": "Welche Herausforderung meistert ihr gemeinsam?" },
      { "wrong": "Was läuft schief?", "right": "Was könnt ihr noch stärker entwickeln?" }
    ],

    "right_framing_patterns": [
      "Wie könnt ihr das gemeinsam stärken?",
      "Welche Gelegenheit liegt darin?",
      "Was könnt ihr voneinander lernen?",
      "Wie wachsen ihr durch diese Unterschiede?",
      "Welche Stärke entwickelt ihr zusammen?"
    ]
