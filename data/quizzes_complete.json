  "passion_questions_template": {
    "note": "IMPORTANT: Always frame scenarios positively. Never ask what 'goes wrong'. Focus on growth and mastery.",
    
    "question_structure": {
      "context": "Emotionales Szenario - beschreibt eine Situation, nicht ein Problem",
      "question": "Offene Frage die das Verhalten/Präferenz zeigt",
      "options": [
        {
          "text": "Beschreibt einen typischen Impuls/Präferenz",
          "scores": { "pole_id": 3 }  // 3 = strongest signal
        }
      ]
    },

    "sample_question_igniter": {
      "context": "Ihr seid zusammen in einer neuen Stadt. Alles ist offen, alles möglich.",
      "question": "Was tust du als erstes?",
      "options": [
        { "text": "Ich checke die Szene und ziehe dich zu einem Ort, der mich interessiert.", "scores": { "INITIATOR": 3, "EXPLORER": 1 } },
        { "text": "Ich lasse mich von der Atmosphäre treiben und schaue, wohin es uns trägt.", "scores": { "CULTIVATOR": 2, "INTENSITY_LOW": 1 } },
        { "text": "Ich frage dich, was dich interessiert – und folge deiner Energie.", "scores": { "RECEIVER": 2, "RESPONDER": 2 } },
        { "text": "Ich suche nach dem intensivsten Erlebnis, das wir hier haben können.", "scores": { "INTENSITY_HIGH": 3, "EXPLORER": 1 } }
      ]
    },

    "sample_question_expressor": {
      "context": "Es war ein besonderer Abend zusammen. Alles stimmte.",
      "question": "Wie zeigst du deinem Menschen, wie sehr es dich berührt hat?",
      "options": [
        { "text": "Ich sage es ihr/him direkt: 'Das war wunderschön, weil...'", "scores": { "EXPRESSOR": 3, "INTENSITY_HIGH": 1 } },
        { "text": "Ich halte sie/ihn fest – eine Umarmung, die alles sagt.", "scores": { "INTENSITY_LOW": 2, "RECEIVER": 2 } },
        { "text": "Ich plane sofort das nächste Mal – ich will das wieder erleben!", "scores": { "INITIATOR": 2, "EXPLORER": 2 } },
        { "text": "Ich bin still zufrieden. Das Gefühl bleibt in mir.", "scores": { "CULTIVATOR": 3, "RECEIVER": 1 } }
      ]
    },

    "sample_question_intensity": {
      "context": "Ihr habt einen aufregenden Plan vor euch – endlich mal was Neues.",
      "question": "Was macht dich am meisten Vorfreude?",
      "options": [
        { "text": "Der Moment selbst – diese eine intensive Stunde.", "scores": { "INTENSITY_HIGH": 3, "EXPRESSOR": 1 } },
        { "text": "Die Vorfreude davor – ich genieße das Hin und Her.", "scores": { "INTENSITY_LOW": 3, "CULTIVATOR": 1 } },
        { "text": "Gemeinsam etwas Neues entdecken – was werden wir finden?", "scores": { "EXPLORER": 3, "INITIATOR": 1 } },
        { "text": "Das Gefühl, wenn wir es zusammen geschafft haben.", "scores": { "CULTIVATOR": 2, "RESPONDER": 2 } }
      ]
    },

    "sample_question_explorer": {
      "context": "Eure Beziehung ist euch vertraut und sicher. Jetzt wollt ihr gemeinsam etwas wagen.",
      "question": "Was reizt euch am meisten?",
      "options": [
        { "text": "Ein komplett neues Erlebnis – etwas, das keiner von euch kennt.", "scores": { "EXPLORER": 3, "INTENSITY_HIGH": 1 } },
        { "text": "Ein vertrautes Erlebnis, aber an einem neuen Ort oder mit neuem Twist.", "scores": { "CULTIVATOR": 2, "EXPLORER": 2 } },
        { "text": "Etwas, das euch beide fordert – gemeinsam wachsen.", "scores": { "INITIATOR": 2, "RESPONDER": 2 } },
        { "text": "Etwas, das eure Verbindung auf eine neue Ebene bringt.", "scores": { "EXPRESSOR": 2, "INTENSITY_LOW": 2 } }
      ]
    }
  },

