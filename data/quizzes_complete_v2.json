# QuissMe Quiz Database - Complete Schema v2
# Based on Love Languages structure from attachment
# Ready for Claude AI to generate quizzes

{
  "_schema_version": "2.0",
  "_last_updated": "2026-02-01",
  "_based_on": "Love Languages Quiz JSON",

  "design_rules": {
    "positive_framing": {
      "principle": "NEVER question the relationship. Always frame as opportunity, growth, mastery.",
      "wrong_patterns": [
        "Was fehlt euch?",
        "Worüber streitet ihr?",
        "Was läuft schief?",
        "Was ist euer Problem?"
      ],
      "right_patterns": [
        "Was wünscht ihr euch?",
        "Wie löst ihr gemeinsam?",
        "Was könnt ihr stärker entwickeln?",
        "Welche Herausforderung meistert ihr?"
      ]
    },
    "couple_constellation": {
      "principle": "Show how partners COMPLEMENT each other, not compare",
      "timing": "Reveal AFTER both partners completed the quiz",
      "tone": "Celebratory, not comparative"
    },
    "buff_system": {
      "principle": "1 buff per 5 quizzes in a cluster",
      "no_stacking": true,
      "duration": "7-14 days"
    }
  },

  "clusters": {
    "love": {
      "name_de": "Liebe",
      "name_en": "Love",
      "buff_name": "Liebesflüsterer",
      "buff_description": "Ihr versteht euch auf einer tiefen emotionalen Ebene.",
      "quiz_count": 5,
      "dimensions": ["words", "time", "gifts", "service", "touch"]
    },
    "growth": {
      "name_de": "Wachstum",
      "name_en": "Growth",
      "buff_name": "Synergie-Meister",
      "buff_description": "Ihr versteht euch blind und könnt Großes bewegen.",
      "quiz_count": 5,
      "dimensions": ["planer", "risk", "motivation", "initiative", "questioning"]
    },
    "passion": {
      "name_de": "Leidenschaft",
      "name_en": "Passion",
      "buff_name": "Leidenschafts-Boost",
      "buff_description": "Eure Verbindung lodert hell.",
      "quiz_count": 5,
      "dimensions": ["initiator", "responder", "expressor", "receiver", "intensity"]
    },
    "stability": {
      "name_de": "Stabilität",
      "name_en": "Stability",
      "buff_name": "Fels in der Brandung",
      "buff_description": "Euch kann nichts erschüttern.",
      "quiz_count": 5,
      "dimensions": ["anchor", "mastermind", "routine", "conflict", "decisions"]
    },
    "future": {
      "name_de": "Zukunft",
      "name_en": "Future",
      "buff_name": "Future-Forward",
      "buff_description": "Ihr blickt gemeinsam nach vorn.",
      "quiz_count": 5,
      "dimensions": ["vision", "ambition", "longterm", "security", "growth"]
    }
  },

